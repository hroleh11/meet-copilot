NODE_ENV="development"
PORT=5070
API_PREFIX="api/v1"
DESKTOP_REDIRECT_URL="meetcopilot://auth"

DATABASE_URL="postgresql://meet_copilot:meet_copilot@localhost:5440/meet_copilot?schema=public"
REDIS_URL="redis://localhost:6390"

AT_SECRET="change-me-access-token-secret"
RT_SECRET="change-me-refresh-token-secret"

GOOGLE_CLIENT_ID="change-me-google-client-id"
GOOGLE_CLIENT_SECRET="change-me-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5070/api/v1/auth/google/callback"

DEEPGRAM_API_KEY="change-me-deepgram-api-key"
OPENAI_API_KEY="change-me-openai-api-key"

REPLY_MODEL="gpt-5.6-terra"
REPLY_EFFORT="low"
SUMMARY_MODEL="gpt-5.4-mini"
SUMMARY_EFFORT="low"
WINDOW_MAX_CHARS=6000
SUMMARY_TRIGGER_CHARS=3000

FINISHED_MEETING_TTL_SECONDS=86400
LIVE_MEETING_IDLE_SECONDS=900
MAX_REQUEST_BODY_BYTES=1048576
LLM_TIMEOUT_MS=60000
STT_CONNECT_TIMEOUT_MS=10000
