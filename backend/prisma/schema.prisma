datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum Language {
  uk
  en
  ru
}

enum MeetingProfile {
  daily
  interview_candidate
  client_call
}

enum MeetingStatus {
  live
  finished
}

enum Speaker {
  me
  other
}

enum GenerationMode {
  reply
  alternative
}

enum UsageKind {
  generate
  summarize
  stt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  credentials UserCredentials?
  settings    UserSettings?
  sessions    AuthSession[]
  meetings    Meeting[]
  usageEvents UsageEvent[]

  @@map("users")
}

model UserCredentials {
  id             String  @id @default(uuid())
  userId         String  @unique @map("user_id")
  hashedPassword String? @map("hashed_password")
  googleId       String? @unique @map("google_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  hashedRt  String   @map("hashed_rt")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model UserSettings {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  style           String?
  defaultLanguage Language       @default(uk) @map("default_language")
  defaultProfile  MeetingProfile @default(daily) @map("default_profile")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Meeting {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  profile   MeetingProfile
  language  Language
  title     String?
  status    MeetingStatus  @default(live)
  summary   String?
  startedAt DateTime       @default(now()) @map("started_at")
  endedAt   DateTime?      @map("ended_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments    Segment[]
  generations Generation[]
  usageEvents UsageEvent[]

  @@index([userId, startedAt])
  @@map("meetings")
}

model Segment {
  id         String   @id @default(uuid())
  meetingId  String   @map("meeting_id")
  speaker    Speaker
  text       String
  startMs    Int      @map("start_ms")
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, startMs])
  @@map("segments")
}

model Generation {
  id                  String         @id @default(uuid())
  meetingId           String         @map("meeting_id")
  mode                GenerationMode
  output              String
  stopReason          String?        @map("stop_reason")
  inputTokens         Int            @default(0) @map("input_tokens")
  cacheReadTokens     Int            @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int            @default(0) @map("cache_creation_tokens")
  outputTokens        Int            @default(0) @map("output_tokens")
  createdAt           DateTime       @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("generations")
}

model UsageEvent {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  meetingId           String?   @map("meeting_id")
  kind                UsageKind
  model               String?
  inputTokens         Int       @default(0) @map("input_tokens")
  cacheReadTokens     Int       @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int       @default(0) @map("cache_creation_tokens")
  outputTokens        Int       @default(0) @map("output_tokens")
  audioSeconds        Int       @default(0) @map("audio_seconds")
  createdAt           DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_events")
}
