datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum Language {
  uk
  en
  ru
}

enum MeetingProfile {
  daily
  interview_candidate
  client_call
}

enum MeetingStatus {
  live
  finished
}

enum Speaker {
  me
  other
}

enum GenerationMode {
  reply
  alternative
}

enum UsageKind {
  generate
  summarize
  stt
  chat
  digest
}

enum ResourceScope {
  user
  project
  meeting
}

enum ResourceKind {
  pdf
  markdown
  text
}

enum ResourceStatus {
  pending
  ready
  failed
}

enum ResourceFailure {
  unreadable
  no_text_layer
  storage
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  credentials UserCredentials?
  settings    UserSettings?
  sessions    AuthSession[]
  projects    Project[]
  meetings    Meeting[]
  resources   Resource[]
  usageEvents UsageEvent[]

  @@map("users")
}

model UserCredentials {
  id             String  @id @default(uuid())
  userId         String  @unique @map("user_id")
  hashedPassword String? @map("hashed_password")
  googleId       String? @unique @map("google_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  hashedRt  String   @map("hashed_rt")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model UserSettings {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  style           String?
  defaultLanguage Language       @default(uk) @map("default_language")
  defaultProfile  MeetingProfile @default(daily) @map("default_profile")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Project {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings  Meeting[]
  resources Resource[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model Meeting {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  projectId     String?        @map("project_id")
  profile       MeetingProfile
  language      Language
  replyLanguage Language?      @map("reply_language")
  title         String?
  status        MeetingStatus  @default(live)
  summary       String?
  overview      String?
  contextBrief  String?        @map("context_brief")
  startedAt     DateTime       @default(now()) @map("started_at")
  endedAt       DateTime?      @map("ended_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments     Segment[]
  generations  Generation[]
  chatSessions ChatSession[]
  resources    Resource[]
  usageEvents  UsageEvent[]

  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@map("meetings")
}

model Resource {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  scope      ResourceScope
  projectId  String?          @map("project_id")
  meetingId  String?          @map("meeting_id")
  kind       ResourceKind
  name       String
  mimeType   String           @map("mime_type")
  byteSize   Int              @map("byte_size")
  storageKey String?          @map("storage_key")
  status     ResourceStatus   @default(pending)
  failure    ResourceFailure?
  text       String?
  digest     String?
  chars      Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId, scope, createdAt])
  @@index([projectId, createdAt])
  @@index([meetingId, createdAt])
  @@map("resources")
}

model Segment {
  id         String   @id @default(uuid())
  meetingId  String   @map("meeting_id")
  speaker    Speaker
  text       String
  startMs    Int      @map("start_ms")
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, startMs])
  @@map("segments")
}

model Generation {
  id                String         @id @default(uuid())
  meetingId         String         @map("meeting_id")
  mode              GenerationMode
  output            String
  stopReason        String?        @map("stop_reason")
  inputTokens       Int            @default(0) @map("input_tokens")
  cachedInputTokens Int            @default(0) @map("cached_input_tokens")
  outputTokens      Int            @default(0) @map("output_tokens")
  hasScreenshot     Boolean        @default(false) @map("has_screenshot")
  createdAt         DateTime       @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("generations")
}

model ChatSession {
  id        String   @id @default(uuid())
  meetingId String   @map("meeting_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting  Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([meetingId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model UsageEvent {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  meetingId         String?   @map("meeting_id")
  kind              UsageKind
  model             String?
  inputTokens       Int       @default(0) @map("input_tokens")
  cachedInputTokens Int       @default(0) @map("cached_input_tokens")
  outputTokens      Int       @default(0) @map("output_tokens")
  audioSeconds      Int       @default(0) @map("audio_seconds")
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("usage_events")
}
