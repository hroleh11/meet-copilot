{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meet Copilot",
  "version": "0.1.0",
  "identifier": "com.meetcopilot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meet Copilot",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Meet Copilot",
        "url": "overlay.html",
        "width": 420,
        "height": 460,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "minWidth": 320,
        "minHeight": 220
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Meet Copilot",
    "shortDescription": "Слухає зустріч і готує відповідь",
    "longDescription": "Meet Copilot слухає мікрофон і звук зустрічі, показує живий транскрипт і за гарячою клавішею готує відповідь в оверлеї.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Meet Copilot Dev"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "meetcopilot"
        ]
      }
    }
  }
}
